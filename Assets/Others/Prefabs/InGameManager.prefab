  m_text: "<color=yellow>[\uB9D0\uBBF8\uC798]</color> \uB9D0\uBBF8\uC798\uC740 \uB2C8\uBAA8\uC758
    <color=#90EE90>\uC548\uC804\uC9C0\uB300</color>\uC785\uB2C8\uB2E4. \uC801 \uBB3C\uACE0\uAE30\uC5D0\uAC8C
    \uCAD3\uAE38 \uB54C \uB9D0\uBBF8\uC798 \uC548\uC73C\uB85C \uC228\uC73C\uBA74
    <color=#90EE90>\uC548\uC804\uD569\uB2C8\uB2E4</color>.\n\n\n\n\n<color=yellow>[\uBA39\uC774
    \uC8FC\uAE30]</color> \uD50C\uB791\uD06C\uD1A4 \uBC30\uB2EC: \uBB3C\uACE0 \uC628
    \uD50C\uB791\uD06C\uD1A4\uC744 \uB9D0\uBBF8\uC798\uC5D0\uAC8C \uC804\uB2EC\uD569\uB2C8\uB2E4.
    \uCC9C\uC801 \uC720\uC778: \uB2C8\uBAA8\uB97C \uCAD3\uC544\uC624\uB294 \uC801
    \uBB3C\uACE0\uAE30\uB97C \uCDA9\uBD84\uD788 \uC131\uC7A5\uD55C \uB9D0\uBBF8\uC798\uC5D0\uAC8C
    \uB370\uB824\uAC00\uBA74, \uB9D0\uBBF8\uC798\uC774 \uC801\uC744 \uC7A1\uC544\uBA39\uC2B5\uB2C8\uB2E4.\n\n\n\n\n<color=yellow>[\uC131\uC7A5]</color>
    \uB9D0\uBBF8\uC798\uC740 \uBA39\uC774\uB97C \uBA39\uC744 \uB54C\uB9C8\uB2E4 \uACBD\uD5D8\uCE58\uAC00
    \uCC28\uC624\uB985\uB2C8\uB2E4. \uACBD\uD5D8\uCE58\uAC00 \uAC00\uB4DD \uCC28\uBA74
    <color=#90EE90>\uB808\uBCA8\uC5C5</color>(<color=#FFA500>Lv.1~5</color>)\uD558\uBA70,
    \uB354 \uD06C\uACE0 \uAC15\uD55C \uBB3C\uACE0\uAE30\uB97C \uBA39\uC744 \uC218
    \uC788\uAC8C \uB429\uB2C8\uB2E4."
